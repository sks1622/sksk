# 이 파일을 복사해서 .env 로 저장한 뒤 값을 채우세요. (.env 는 git 에 올라가지 않습니다)

# Claude API 키 (https://console.anthropic.com → API Keys)
ANTHROPIC_API_KEY=

# Instagram 액세스 토큰 (README 의 "토큰 발급" 참고)
IG_ACCESS_TOKEN=
# Instagram 비즈니스 계정 ID (모르면 비워 두세요. 기본값 me)
IG_USER_ID=

# 선택 설정
# IG_GRAPH_VERSION=v23.0
# IG_CLAUDE_MODEL=claude-opus-5-5
